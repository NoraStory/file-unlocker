{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileUnlocker",
  "version": "0.1.0",
  "identifier": "com.story.fileunlocker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "文件占用解除",
        "width": 480,
        "height": 640,
        "minWidth": 400,
        "minHeight": 500,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
